{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MarketData": {
    "Yahoo": {
      "BaseUrl": "https://query1.finance.yahoo.com/",
      "Range": "1mo",
      "Interval": "15m",
      "AttemptTimeoutSeconds": 5,
      "MaxRetryAttempts": 2
    }
  },
  "StockSummary": {
    "CacheSeconds": 60
  },
  "RateLimiting": {
    "PermitLimit": 30,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
